  <!-- mTLS MQTT X.509 -->
        <tls-tcp-listener>     
                <port>9999</port>
                <bind-address>0.0.0.0</bind-address>
                <name>x509-listener</name>
                <tls>
                    <keystore>
                        <path>./conf/hivemq.jks</path>
                        <password>changeit</password>
                        <private-key-password>changeit</private-key-password>
                    </keystore>
                    <truststore>
                        <path>./conf/hivemq-trust-store.jks</path>
                        <password>changeme</password>
                    </truststore>
                    <protocols>
                        <protocol>TLSv1.2</protocol>
                        <protocol>TLSv1.3</protocol>
                    </protocols>
                </tls>
        </tls-tcp-listener>


        
    </listeners>

    <control-center>
        <enabled>true</enabled>
        <listeners>
            <http>
                <port>8080</port>
                <bind-address>0.0.0.0</bind-address>
            </http>
        </listeners>
    </control-center>

    <rest-api>
        <enabled>true</enabled>
        <listeners>
            <http>
                <port>8888</port>
                <bind-address>0.0.0.0</bind-address>
            </http>
        </listeners>
    </rest-api>


    <health-api>
        <enabled>true</enabled>
        <listeners>
        <http>
            <port>8889</port>
            <name>health-api-listener</name>
            <bind-address>0.0.0.0</bind-address>
        </http>
        </listeners>
    </health-api>


    <anonymous-usage-statistics>
        <enabled>false</enabled>
    </anonymous-usage-statistics>

    <data-hub>
        <modules>
            <registries>
                <remote>
                    <enabled>true</enabled>
                    <name>HiveMQ SE Registry</name>
                    <id>SE-git-registry</id>
                    <url>https://raw.githubusercontent.com/hivemq/Datahub-SE-Registry/refs/heads/main/registry.json</url>
                </remote>
            </registries>
        </modules>
    </data-hub>



</hivemq>
